# Copy to .env and set credentials locally. Never commit .env.
# This file is sourced by the quick-start shell commands; use valid shell quoting.
# Source only a trusted copy. Never add actual credentials to this tracked example.
# Provider compatibility, filters, auth and replay retention must be verified.
CORE_PROVIDER_A_ENDPOINT=solana-yellowstone-grpc.publicnode.com:443
CORE_PROVIDER_A_TOKEN=
CORE_PROVIDER_A_TOKEN_HEADER=x-token

# Optional second provider (set source_count=2 in config.json).
CORE_PROVIDER_B_ENDPOINT=
CORE_PROVIDER_B_TOKEN=
CORE_PROVIDER_B_TOKEN_HEADER=x-token

CORE_CONFIG=./config.json
CORE_REPLAY_ONLY=0
